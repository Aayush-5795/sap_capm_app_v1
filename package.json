{
  "name": "CAPMAPP",
  "version": "1.0.0",
  "dependencies": {
    "@cap-js-community/odata-v2-adapter": "^1.15.12",
    "@cap-js/hana": "^2",
    "@sap/cds": "^9",
    "@sap/xssec": "^4"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^2",
    "@sap/cds-dk": "^9",
    "cds-plugin-ui5": "^0.13.0"
  },
  "scripts": {
    "start": "cds-serve",
    "watch-managepo": "cds watch --open aayush.ui.managepo/index.html?sap-ui-xx-viewCache=false --livereload false"
  },
  "private": true,
  "workspaces": [
    "app/*"
  ],
  "sapux": [
    "app/managepo"
  ],
  "cds": {
    "requires": {
      "auth": {
        "[development]": {
          "kind": "mocked",
          "users": {
            "aayush": {
              "password": "admin",
              "roles": [
                "Viewer"
              ],
              "attr": {
                "spiderman": ["My Bank of London"]
              }
            }
          },
          "[production]": {
            "kind": "xsuaa"
          }
        },
        "[production]": {
          "auth": {
            "kind": "xsuaa"
          }
        }
      }
    }
  }
}
